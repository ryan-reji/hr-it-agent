# Copy to .env and add project-specific environment variables.

# OpenAI
GEMINI_API_KEY=your_api_key

GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001


# PostgreSQL
DATABASE_URL=postgresql://hr_admin:hr_local_password@localhost:5432/hr_it_helpdesk

# Employee identity
CURRENT_USER_ID=E101
CURRENT_USER_ROLE=employee

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION=hr_it_policies

# RAG
RAG_TOP_K=5

# Application
LOG_LEVEL=INFO
